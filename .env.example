# App
NODE_ENV=production
PORT=3000
# Public origin — MUST be https:// in Coolify so session cookies get Secure
APP_URL=https://your-domain.example
SESSION_SECRET=replace-with-long-random-secret-min-32-chars

# Coolify managed Postgres connection string
# Coolify: paste managed Postgres URL
# Local compose DB: postgresql://tecloud:tecloud@localhost:5433/tecloud
DATABASE_URL=postgresql://tecloud:tecloud@db:5432/tecloud

# Storage
# mock = local disk at STORAGE_PATH (mount persistent volume)
# telegram = GramJS user session (see README)
STORAGE_DRIVER=mock
STORAGE_PATH=/data/storage
MAX_UPLOAD_BYTES=1073741824

# Optional: first-admin bootstrap username (if your seed/logic uses it)
ADMIN_USERNAME=demo

# Telegram verification bot (BotFather) — leave empty to log deep-links to console
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=tecloudapp_bot
TELEGRAM_WEBHOOK_SECRET=
# After deploy:
# curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#   -d "url=$APP_URL/api/telegram/webhook" \
#   -d "secret_token=$TELEGRAM_WEBHOOK_SECRET"

# Telegram MTProto storage (user account, NOT the bot) — only if STORAGE_DRIVER=telegram
# 1) https://my.telegram.org → api_id + api_hash
# 2) npm run telegram:session
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_STORAGE_CHAT_ID=me
